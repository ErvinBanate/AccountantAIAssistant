# Copy to .env.docker. This is separate from the native Laravel .env file.
APP_PORT=8080
APP_URL=http://localhost:8080
APP_ENV=local
APP_DEBUG=false
# Leave blank to generate a persistent key automatically on first startup.
APP_KEY=

DB_DATABASE=ledgerly
DB_USERNAME=ledgerly
DB_PASSWORD=ledgerly_local_password
DB_ROOT_PASSWORD=ledgerly_local_root_password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/gmail/callback

# Optional. Leave blank to keep paid AI proposals disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
